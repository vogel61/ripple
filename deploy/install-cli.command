#!/bin/bash
# RIPPLE — install the `ripple` command (#121). Double-click this file.
#
# Writes a two-line wrapper that runs the proxy from *this* checkout with *this*
# checkout's virtualenv. No sudo, no pip install, no edit of any shell profile:
#
#   /usr/local/bin/ripple          when that directory exists and is writable
#   ~/.local/bin/ripple            otherwise, with a printed PATH hint
#
# The wrapper is generated, not copied: it carries the absolute path of the
# repository and of the interpreter, so `ripple` works from any directory. It is
# rewritten on every run and the run is idempotent — the same inputs produce the
# same file, and the script says so instead of pretending to have changed
# something.
#
#   ./deploy/install-cli.command --dry-run   # only say what it would do
#   RIPPLE_CLI_DIR=/tmp/x ./deploy/install-cli.command   # tests: no /usr/local

set -u
cd "$(dirname "$0")/.." || exit 1

REPO="$(pwd)"
PY="${RIPPLE_PYTHON:-$REPO/.venv/bin/python}"
DRY=0
QUIET=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY=1 ;;
        --quiet)   QUIET=1 ;;   # for install-launchd.command: no banner, no key press
        *) printf 'unknown option: %s\n' "$arg" >&2; exit 2 ;;
    esac
done
FAIL=0

say()  { printf '%s\n' "$*"; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAIL=1; }
plan() { printf '  would %s\n' "$*"; }

finish() {
    if [ "$QUIET" = "0" ]; then
        say ""
        say "──────────────────────────────────────────────────────────────"
        if [ "$DRY" = "1" ]; then
            say "Result: dry run — nothing was changed."
        elif [ "$FAIL" = "0" ]; then
            say "Result: the command is installed. Try: ripple status"
        else
            say "Result: FAILED — see the lines marked FAIL above."
        fi
        say ""
    fi
    if [ -t 0 ] && [ "$QUIET" = "0" ]; then
        read -r -n 1 -s -p "Press any key to close …"; say ""
    fi
    exit "$FAIL"
}

if [ "$QUIET" = "0" ]; then
    say ""
    say "RIPPLE — install the ripple command"
    say "──────────────────────────────────────────────────────────────"
    [ "$DRY" = "1" ] && say "DRY RUN — nothing is changed."
    say "repo:  $REPO"
fi

# --- 1 ---------------------------------------------------------------------
step "1/3  find the interpreter"
if [ ! -x "$PY" ]; then
    bad "no executable python at $PY"
    say "  next: create the environment (see deploy/README.md), or set RIPPLE_PYTHON"
    finish
fi
if ! "$PY" -c "import ripple" >/dev/null 2>&1; then
    bad "$PY cannot import ripple — run it from the repository root"
    finish
fi
ok "$PY"

# --- 2 ---------------------------------------------------------------------
step "2/3  choose the target directory"
if [ -n "${RIPPLE_CLI_DIR:-}" ]; then
    TARGET_DIR="$RIPPLE_CLI_DIR"
elif [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
    TARGET_DIR="/usr/local/bin"
else
    TARGET_DIR="$HOME/.local/bin"
fi
TARGET="$TARGET_DIR/ripple"
if [ "$DRY" = "1" ]; then
    plan "write $TARGET"
else
    mkdir -p "$TARGET_DIR" || bad "cannot create $TARGET_DIR"
    [ -w "$TARGET_DIR" ] || bad "$TARGET_DIR is not writable — no sudo here; set RIPPLE_CLI_DIR"
fi
ok "target: $TARGET"

# --- 3 ---------------------------------------------------------------------
step "3/3  write the wrapper"
WRAPPER="#!/bin/sh
# RIPPLE — generated by deploy/install-cli.command (#121); re-run that script
# after moving the checkout. The venv holds no installed copy of the package, so
# the working directory has to be the repository root.
cd \"$REPO\" || { echo \"ripple: cannot enter $REPO\" >&2; exit 1; }
exec \"$PY\" -m ripple \"\$@\"
"
if [ "$DRY" = "1" ]; then
    plan "write a wrapper for $PY in $REPO"
    plan "check it answers: $TARGET --version"
    finish
fi

if [ -f "$TARGET" ] && [ "$(cat "$TARGET")" = "$(printf '%s' "$WRAPPER")" ]; then
    ok "already installed and up to date"
else
    if printf '%s' "$WRAPPER" > "$TARGET"; then
        chmod 755 "$TARGET"
        ok "written, 0755"
    else
        bad "could not write $TARGET"
        finish
    fi
fi

# --- verify (a wrapper that cannot run is not installed) -------------------
if OUT="$("$TARGET" --version 2>&1)"; then
    ok "$TARGET --version → $OUT"
else
    bad "$TARGET --version failed: $OUT"
fi

case ":$PATH:" in
    *":$TARGET_DIR:"*) ok "$TARGET_DIR is on PATH" ;;
    *)
        say ""
        say "  $TARGET_DIR is not on PATH. Add it once to your shell profile:"
        say "    export PATH=\"$TARGET_DIR:\$PATH\""
        ;;
esac

finish
